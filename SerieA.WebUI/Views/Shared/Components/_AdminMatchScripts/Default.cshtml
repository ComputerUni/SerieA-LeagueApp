@using SerieA.API.Entities.Enums
@using SerieA.API.Extensions
@model MatchListViewModel

@{
    var statuses = Enum.GetValues<MatchStatus>()
                .Select(s => new
                {
                    Key = (int)s,
                    Name = s.GetDisplayName()
                }).ToList();

    var statusDict = statuses.ToDictionary(x => x.Key, x => x.Name);
}

<script>
    (function() {
        'use strict';

        let teamsArray = @Html.Raw(Json.Serialize(Model.Teams.Select(t => new
            {
                id = t.Id,
                                                    name = t.Name,
                                                    code = t.ShortCode,
                                                    city = t.City,
                                                    region = t.Region,
                                                    stadium = t.Stadium,
                                                    capacity = t.StadiumCapacity,
                                                    founded = t.FoundationYear,
                                                    colorA = t.PrimaryColor,
                                                    colorB = t.SecondaryColor,
                                                    status = t.IsActive ? "active" : "inactive"
                            })));

        const TEAMS = Object.fromEntries(teamsArray.map(t => [t.id, t]));

        const STATUS = @Html.Raw(Json.Serialize(statusDict));

        let matches = @Html.Raw(Json.Serialize(Model.Matches.Select(m => new
            {
                id = m.Id,
                                                    week = m.Week,
                                                    date = m.MatchDate.ToString("yyyy-MM-dd"),
                                                    time = m.MatchTime.ToString("HH:mm"),
                                                    home = m.HomeTeamId,
                                                    away = m.AwayTeamId,
                                                    homeScore = m.HomeTeamScore,
                                                    awayScore = m.AwayTeamScore,
                                                    status = (int)m.Status,
                                                    stadium = m.Stadium
                            })));


        /* ---------- Yardımcılar ---------- */
        const $ = (sel, root = document) => root.querySelector(sel);
        const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        const fmtDate = (iso) => iso.split('-').reverse().join('.');
        const norm = (s) => s.toLocaleLowerCase('tr-TR').normalize('NFD').replace(/[\u0300-\u036f]/g, '');
        const hasScore = (m) => m.status === 3 || m.status === 2;
        const icon = (id) => `<svg class="icon" aria-hidden="true"><use href="#i-${id}"/></svg>`;
        const teamCell = (id) =>
            `<span class="team"><span class="team-crest" style="--crest-a:${TEAMS[id].colorA};--crest-b:${TEAMS[id].colorB}" aria-hidden="true"></span>${esc(TEAMS[id].name)}</span>`;

        /* ---------- Tablo ---------- */
        const els = {
            rows: $('[data-match-rows]'),
            count: $('[data-result-count]'),
            filter: $('[data-filter-form]'),
            modal: $('#match-modal'),
            form: $('[data-match-form]'),
            title: $('#match-modal-title'),
            alert: $('[data-form-alert]'),
            scoreFields: $('[data-score-fields]'),
            del: $('#delete-modal'),
            delText: $('[data-delete-text]'),
            toasts: $('[data-toasts]'),
            statsModal: $('#stats-modal'),
            statsForm: $('[data-stats-form]'),
            goalsModal: $('#goal-modal'),
            goalsForm: $('[data-goal-form]')
        };
        let filters = { team: '', week: '', status: '' };

        function applyFilters(list) {
            const q = norm(filters.team.trim());
            return list.filter((m) =>
                (!q || norm(TEAMS[m.home].name).includes(q) || norm(TEAMS[m.away].name).includes(q)) &&
                (!filters.week || String(m.week) === filters.week) &&
                (!filters.status || m.status === filters.status));
        }

        function renderTable(highlightId) {
            const list = applyFilters(matches).sort((a, b) => a.id - b.id);
            if (!list.length) {
                els.rows.innerHTML = `<tr class="table-empty"><td colspan="9"><strong>Kayıt bulunamadı</strong>Filtreleri değiştirin ya da Temizle ile tüm maçları gösterin.</td></tr>`;
            } else {
                els.rows.innerHTML = list.map((m) => `
                                                <tr data-id="${m.id}"${m.id === highlightId ? ' class="is-new"' : ''}>
                                                  <td class="col-id"><span>${m.id}</span></td>
                                                  <td class="week-cell">${m.week}. Hafta</td>
                                                  <td>${fmtDate(m.date)}</td>
                                                  <td>${m.time}</td>
                                                  <td>${teamCell(m.home)}</td>
                                                  <td class="col-score">${hasScore(m)
                        ? `<span class="score">${m.homeScore} - ${m.awayScore}</span>`
                        : '<span class="score score--empty">-</span>'}</td>
                                                  <td>${teamCell(m.away)}</td>
                                                  <td><span class="badge-a badge-a--${m.status}">${STATUS[m.status]}</span></td>
                                                  <td class="col-actions">
                                                    <div class="row-actions">
                                                      <a class="act-btn" href="/Match/MatchDetail/${m.id}" data-demo-nav title="Detay" aria-label="Detay: ${esc(TEAMS[m.home].name)} - ${esc(TEAMS[m.away].name)}">${icon('eye')}</a>
                                                      <button type="button" class="act-btn" data-edit="${m.id}" title="Düzenle" aria-label="Düzenle: ${esc(TEAMS[m.home].name)} - ${esc(TEAMS[m.away].name)}">${icon('edit')}</button>
                                                      <button type="button" class="act-btn ${(m.status === 2 || m.status === 3) ? '' : 'act-btn--disabled'}" ${(m.status === 2 || m.status === 3) ? `data-stats="${m.id}"` : 'disabled'}" title="İstatistik">${icon('chart')}</button>
                                                      <button type="button" class="act-btn ${(m.status === 2 || m.status === 3) ? '' : 'act-btn--disabled'} " ${(m.status === 2 || m.status === 3) ? `data-goals="${ m.id } "` : 'disabled'} title="Goller">${icon('ball')}</button>
                                                      <button type="button" class="act-btn act-btn--danger" data-delete="${m.id}" title="Sil" aria-label="Sil: ${esc(TEAMS[m.home].name)} - ${esc(TEAMS[m.away].name)}">${icon('trash')}</button>
                                                    </div>
                                                  </td>
                                                </tr>`).join('');
            }
            els.count.textContent = `${matches.length} kayıttan ${list.length} tanesi gösteriliyor`;
        }

        els.filter.addEventListener('submit', (e) => {
            e.preventDefault();
            const fd = new FormData(els.filter);
            filters = { team: fd.get('team') || '', week: fd.get('week') || '', status: fd.get('status') || '' };
            renderTable();
        });
        $('[data-filter-reset]').addEventListener('click', () => {
            els.filter.reset();
            filters = { team: '', week: '', status: '' };
            renderTable();
        });

        /* ---------- Form seçeneklerini doldur ---------- */
        const f = els.form.elements;
        f.week.innerHTML = '<option value="">Hafta seçin</option>' +
            Array.from({ length: 38 }, (_, i) => `<option value="${i + 1}">${i + 1}. Hafta</option>`).join('');
        const teamOptions = '<option value="">Takım seçin</option>' +
            Object.entries(TEAMS).map(([id, t]) => `<option value="${id}">${t.name}</option>`).join('');
        f.home.innerHTML = teamOptions;
        f.away.innerHTML = teamOptions;

        let stadiumTouched = false;
        f.stadium.addEventListener('input', () => { stadiumTouched = f.stadium.value.trim() !== ''; });
        f.home.addEventListener('change', () => {
            if (!stadiumTouched && TEAMS[f.home.value]) f.stadium.value = TEAMS[f.home.value].stadium;
            clearError('home');
        });
        f.status.addEventListener('change', toggleScoreFields);
        function toggleScoreFields() {
            const v = Number(f.status.value);
            const show = v === 2 || v === 3;
            els.scoreFields.hidden = !show;
            if (!show) { clearError('homeScore'); clearError('awayScore'); }
        }
        ['week', 'away', 'date', 'time', 'homeScore', 'awayScore'].forEach((n) =>
            f[n].addEventListener('input', () => clearError(n)));

        /* ---------- Doğrulama ---------- */
        function setError(name, msg) {
            const field = els.form.querySelector(`[data-field="${name}"]`);
            field.classList.add('has-error');
            field.querySelector('.field-error').textContent = msg;
            f[name].setAttribute('aria-invalid', 'true');
        }
        function clearError(name) {
            const field = els.form.querySelector(`[data-field="${name}"]`);
            if (!field) return;
            field.classList.remove('has-error');
            f[name].removeAttribute('aria-invalid');
        }
        function clearAllErrors() {
            els.form.querySelectorAll('.has-error').forEach((el) => el.classList.remove('has-error'));
            els.form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
            els.alert.classList.remove('is-visible');
        }

        function validate(data) {
            const errors = [];
            if (!data.week) errors.push(['week', 'Lütfen bir hafta seçin.']);
            if (!data.home) errors.push(['home', 'Lütfen ev sahibi takımı seçin.']);
            if (!data.away) errors.push(['away', 'Lütfen deplasman takımını seçin.']);
            else if (data.home && data.home === data.away) errors.push(['away', 'Ev sahibi ve deplasman takımı aynı olamaz.']);
            if (!data.date) errors.push(['date', 'Lütfen maç tarihini seçin.']);
            if (!data.time) errors.push(['time', 'Lütfen maç saatini seçin.']);
            if (Number(data.status) === 2 || Number(data.status) === 3) {
                ['homeScore', 'awayScore'].forEach((k) => {
                    const v = data[k];
                    if (v === '' || !Number.isInteger(Number(v)) || Number(v) < 0)
                        errors.push([k, 'Geçerli bir skor girin (0 veya üzeri).']);
                });
            }
            return errors;
        }

        /* ---------- Modal aç / kapat ---------- */
        let lastFocus = null;
        function openModal(mode, match) {
            lastFocus = document.activeElement;
            els.form.reset();
            clearAllErrors();
            stadiumTouched = false;
            f.id.value = '';
            f.status.value = '1';
            if (mode === 'edit' && match) {
                els.title.textContent = 'Maçı Düzenle';
                f.id.value = match.id;
                f.week.value = match.week;
                f.home.value = match.home;
                f.away.value = match.away;
                f.date.value = match.date;
                f.time.value = match.time;
                f.stadium.value = match.stadium || '';
                f.status.value = match.status;
                f.homeScore.value = match.homeScore ?? '';
                f.awayScore.value = match.awayScore ?? '';
                stadiumTouched = true;
            } else {
                els.title.textContent = 'Yeni Maç Ekle';
            }
            toggleScoreFields();
            els.modal.showModal();
            f.week.focus();
        }
        function closeModal() {
            els.modal.close();
        }
        els.modal.addEventListener('close', () => { if (lastFocus) lastFocus.focus(); });
        els.modal.addEventListener('click', (e) => { if (e.target === els.modal) closeModal(); });  // arka plana tıklama
        document.querySelectorAll('[data-modal-close]').forEach((b) => b.addEventListener('click', closeModal));
        $('[data-open-create]').addEventListener('click', () => openModal('create'));

        /* ---------- Kaydet (ekle / güncelle) ---------- */
        els.form.addEventListener('submit', async (e) => {
            e.preventDefault();
            clearAllErrors();
            const data = Object.fromEntries(new FormData(els.form).entries());
            const errors = validate(data);
            if (errors.length) {
                errors.forEach(([name, msg]) => setError(name, msg));
                els.alert.classList.add('is-visible');
                f[errors[0][0]].focus();
                return;
            }

            const scored = Number(data.status) === 2 || Number(data.status) === 3;

            let formattedTime = data.time;
            if (formattedTime && formattedTime.length === 5) {
                formattedTime += ':00';
            }

            const record = {
                week: Number(data.week),
                matchDate: data.date,
                matchTime: formattedTime,
                homeTeamId: Number(data.home),
                awayTeamId: Number(data.away),
                stadium: data.stadium.trim() || TEAMS[data.home].stadium,
                status: Number(data.status),
                homeScore: scored ? Number(data.homeScore) : null,
                awayScore: scored ? Number(data.awayScore) : null
            };

            let savedId;
            try {
                if (data.id) {
                    // API: PUT /api/admin/matches/{id}
                    const res = await fetch('https://localhost:7078/api/Matches', {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ id: Number(data.id), ...record })
                    });
                    if (!res.ok) throw new Error(`PUT ${res.status}`);
                    savedId = Number(data.id);
                    matches = matches.map((m) => (m.id === savedId ? { ...m, ...record } : m));
                    toast('Maç başarıyla güncellendi.');
                } else {
                    // API: POST /api/admin/matches
                    const res = await fetch('https://localhost:7078/api/Matches', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(record)
                    });
                    if (!res.ok) throw new Error(`POST ${res.status}`);
                    savedId = Math.max(0, ...matches.map((m) => m.id)) + 1;
                    matches.push({ id: savedId, ...record });
                    toast('Maç başarıyla eklendi.');
                }
            } catch (err) {
                console.error(err);
                els.alert.textContent = 'Sunucuya kaydedilemedi: ' + err.message;
                els.alert.classList.add('is-visible');
                return;
            }

            closeModal();
            renderTable(savedId);
            const row = els.rows.querySelector(`[data-id="${savedId}"]`);
            if (row) row.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
            else toast('Yeni kayıt mevcut filtreler nedeniyle gizli.', 'info');
        });

        /* ---------- Düzenle / Sil ---------- */
        let pendingDelete = null;
        els.rows.addEventListener('click', async (e) => {
            const edit = e.target.closest('[data-edit]');
            const del = e.target.closest('[data-delete]');
            if (edit) openModal('edit', matches.find((m) => m.id === Number(edit.dataset.edit)));
            if (del) {
                const m = matches.find((x) => x.id === Number(del.dataset.delete));
                pendingDelete = m.id;
                els.delText.innerHTML = `<strong>${esc(TEAMS[m.home].name)} - ${esc(TEAMS[m.away].name)}</strong> (ID ${m.id}, ${m.week}. Hafta) kalıcı olarak silinecek. Bu işlem geri alınamaz.`;
                els.del.returnValue = '';
                els.del.showModal();
            }
        });
        els.del.addEventListener('close', async () => {
            if (els.del.returnValue === 'confirm' && pendingDelete !== null) {
                // API: DELETE /api/admin/matches/{id}
                try {
                    const res = await fetch(`https://localhost:7078/api/Matches?id=${pendingDelete}`, {
                        method: 'DELETE'
                    });
                    if (!res.ok) throw new Error(`DELETE ${res.status}`);
                    matches = matches.filter((m) => m.id !== pendingDelete);
                    renderTable();
                    toast('Maç silindi.');
                } catch (err) {
                    console.error(err);
                    toast('Silinemedi: ' + err.message, 'info');
                }

            }
            pendingDelete = null;
        });

        let currentMatchGoals = [];
        let activeGoalMatchId = null;

        document.querySelectorAll('[data-goal-modal-close]').forEach(g => g.addEventListener('click', () => els.goalsModal.close()));

        els.rows.addEventListener('click', async (e) => {
            const goals = e.target.closest('[data-goals]');
            if (!goals) return;

            activeGoalMatchId = Number(goals.dataset.goals);
            const m = matches.find(x => x.id === activeGoalMatchId);

            $('#goal-home-name').textContent = TEAMS[m.home].name;
            $('#goal-away-name').textContent = TEAMS[m.away].name;
            $('#goal-match-id').value = activeGoalMatchId;

            const teamSelect = $('#goal-team-id');
            teamSelect.innerHTML = `
                <option value="">Takım Seçiniz</option>    
                <option value="${m.home}">${TEAMS[m.home].name} (Ev Sahibi)</option>    
                <option value="${m.away}">${TEAMS[m.away].name} (Deplasman)</option>    
            `
            
            resetGoalForm();
            await loadGoals(activeGoalMatchId);
            els.goalsModal.showModal();
        });

        async function loadGoals(matchId) {
            const listEl = $('#goal-list');
            listEl.innerHTML = '<span style="color:#94a3b8; font-size:0.85rem;">Yükleniyor...</span>';

            try {
                const res = await fetch(`https://localhost:7078/api/MatchGoals/${matchId}`);
                if(!res.ok) throw new Error('Goller Getirilemedi');

                currentMatchGoals = await res.json();
                renderGoalList(currentMatchGoals);
            } catch(err) {
                listEl.innerHTML = '<span style="color:#ef4444; font-size:0.85rem;">Goller yüklenirken hata oluştu.</span>';
            }
        }

        function renderGoalList(goals) {
            const listEl = $('#goal-list');
           if(!goals || goals.length === 0) {
                listEl.innerHTML = '<span style="color:#94a3b8; font-size:0.85rem;">Bu maçta henüz gol kaydı yok.</span>';
                return;
           }

           goals.sort((a,b) => (a.minute ?? a.Minute) - (b.minute ?? b.Minute));

           listEl.innerHTML = goals.map(g => {
               const id = g.id ?? g.Id;
               const minute = g.minute ?? g.Minute;
               const player = g.playerName ?? g.PlayerName;
               const assist = g.assistPlayerName ?? g.AssistPlayerName;
               const teamId = g.teamId ?? g.TeamId;
               const teamName = TEAMS[teamId] ? TEAMS[teamId].name : 'Takım';

                return `
                <div class="event-item" style="display:flex; align-items:center; justify-content:space-between; padding:8px 12px; background:rgba(255,255,255,0.04); border-radius:6px; margin-bottom:6px;">
                    <div>
                        <strong>${minute}'</strong> ⚽ <strong>${player}</strong>
                        <span style="font-size:0.8rem; color:#94a3b8;">(${teamName})</span>
                        ${assist ? `<span style="font-size:0.8rem; color:#64748b; margin-left:6px;">(Asist: ${assist})</span>` : ''}
                    </div>
                    <div style="display:flex; gap:6px;">
                        <button type="button" class="btn-stat btn-stat--ghost" style="padding:4px 8px; font-size:0.75rem;" onclick="editGoal(${id})">Düzenle</button>
                        <button type="button" class="btn-stat btn-stat--ghost" style="padding:4px 8px; font-size:0.75rem; color:#ef4444;" onclick="deleteGoal(${id})">Sil</button>
                    </div>
                </div>
            `;
           }).join('');
        }

        els.goalsForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const f = els.goalsForm.elements;
            const goalId = f.id.value ? Number(f.id.value) : null;

            const payload = {
                matchId: Number(f.matchId.value),
                teamId: Number(f.teamId.value),
                playerName: f.playerName.value.trim(),
                assistPlayerName: f.assistPlayerName.value.trim() || null,
                minute: Number(f.minute.value)
            };

            if(goalId) payload.id = goalId;

            try {
                const url = 'https://localhost:7078/api/MatchGoals'

                const res = await fetch(url, {
                    method: goalId ? 'PUT' : 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify(payload)
                });

                if(!res.ok){
                    const error = await res.text();
                    throw new Error(error || 'İşlem Gerçekleştirilemedi');
                }

                if(!goalId){
                    const m = matches.find(x => x.id === activeGoalMatchId);
                    if(m) {
                        if(m.status === 1) m.status = 2;
                        if(payload.teamId === m.home) {
                            m.homeScore = (m.homeScore ?? 0) + 1;
                        } else if(payload.teamId === m.away) {
                            m.awayScore = (m.awayScore ?? 0) + 1;
                        }
                        renderTable();
                    }
                }

                toast(goalId ? 'Gol Başarıyla Güncellendi' : 'Gol Başarıyla Eklendi.');
                resetGoalForm();
                await loadGoals(activeGoalMatchId);
            } catch(err) {
                toast('Hata: ' + err.message, 'info');
            }
        });

        function resetGoalForm() {
            els.goalsForm.reset();
            $('#goal-id').value = '';
            $('#goal-match-id').value = activeGoalMatchId;
            $('#goal-submit-btn').textContent = 'Gol Ekle';
            const cancelBtn = $('#goal-reset-btn');
            if(cancelBtn) cancelBtn.style.display = 'none';
        }

        window.editGoal = function(id) {
            const goal = currentMatchGoals.find(g => (g.id ?? g.Id) === id);
            if (!goal) return;

            const f = els.goalsForm.elements;
            f.id.value = goal.id ?? goal.Id;
            f.teamId.value = goal.teamId ?? goal.TeamId;
            f.playerName.value = goal.playerName ?? goal.PlayerName;
            f.assistPlayerName.value = goal.assistPlayerName ?? goal.AssistPlayerName ?? '';
            f.minute.value = goal.minute ?? goal.Minute;

            $('#goal-submit-btn').textContent = 'Güncelle';
            const cancelBtn = $('#goal-reset-btn');
            if (cancelBtn) cancelBtn.style.display = 'inline-block';
        };




        let existingHomeStatId = null;
        let existingAwayStatId = null

        document.querySelectorAll('[data-stats-modal-close]').forEach(b => b.addEventListener('click', () => els.statsModal.close()));

        els.rows.addEventListener('click', async (e) => {
            const stats = e.target.closest('[data-stats]');
            if (!stats) return;

            const matchId = Number(stats.dataset.stats);
            const m = matches.find(x => x.id === matchId);

            $('#stats-home-name').textContent = TEAMS[m.home].name;
            $('#stats-away-name').textContent = TEAMS[m.away].name;
            $('#stats-match-id').value = matchId;
            $('#stats-home-id').value = m.home;
            $('#stats-away-id').value = m.away;

            existingAwayStatId = null;
            existingHomeStatId = null;
            els.statsForm.reset();

            try {
                const res = await fetch(`https://localhost:7078/api/MatchStatistics/${matchId}`);
                if (res.ok) {
                    const data = await res.json();
                    const home = data.find(x => (x.teamId ?? x.TeamId) == m.home);
                    const away = data.find(x => (x.teamId ?? x.TeamId) == m.away);
                    if (home) { fillStatsForm('home', home); existingHomeStatId = home.id; }
                    if (away) { fillStatsForm('away', away); existingAwayStatId = away.id; }
                }
            } catch (err) {
                console.error(err);
            }
            els.statsModal.showModal();
        });

        function fillStatsForm(side, data) {
            const f = els.statsForm.elements;
            f[`${side}Possession`].value = data.possession ?? data.Possession ?? 0;
            f[`${side}Shots`].value = data.shots ?? data.Shots ?? 0;
            f[`${side}ShotsOnTarget`].value = data.shotsOnTarget ?? data.ShotsOnTarget ?? 0;
            f[`${side}Passes`].value = data.passes ?? data.Passes ?? 0;
            f[`${side}PassAccuracy`].value = data.passAccuracy ?? data.PassAccuracy ?? 0;
            f[`${side}Corners`].value = data.corners ?? data.Corners ?? 0;
            f[`${side}Fouls`].value = data.fouls ?? data.Fouls ?? 0;
            f[`${side}Offsides`].value = data.offsides ?? data.Offsides ?? 0;
        }

        els.statsForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const f = els.statsForm.elements;
            const matchId = Number(f.matchId.value);
            const homeTeamId = Number(f.homeTeamId.value);
            const awayTeamId = Number(f.awayTeamId.value);

            const homeData = {
                matchId,
                teamId: homeTeamId,
                possession: Number(f.homePossession.value),
                shots: Number(f.homeShots.value),
                shotsOnTarget: Number(f.homeShotsOnTarget.value),
                passes: Number(f.homePasses.value),
                passAccuracy: Number(f.homePassAccuracy.value),
                corners: Number(f.homeCorners.value),
                fouls: Number(f.homeFouls.value),
                offsides: Number(f.homeOffsides.value)
            };

            const awayData = {
                matchId,
                teamId: awayTeamId,
                possession: Number(f.awayPossession.value),
                shots: Number(f.awayShots.value),
                shotsOnTarget: Number(f.awayShotsOnTarget.value),
                passes: Number(f.awayPasses.value),
                passAccuracy: Number(f.awayPassAccuracy.value),
                corners: Number(f.awayCorners.value),
                fouls: Number(f.awayFouls.value),
                offsides: Number(f.awayOffsides.value)
            };

            try {
                await Promise.all([
                    fetch(existingHomeStatId
                        ? `https://localhost:7078/api/MatchStatistics/${existingHomeStatId}`
                        : 'https://localhost:7078/api/MatchStatistics', {
                        method: existingHomeStatId ? 'PUT' : 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(existingHomeStatId ? { id: existingHomeStatId, ...homeData } : homeData)
                    }),
                    fetch(existingAwayStatId
                        ? `https://localhost:7078/api/MatchStatistics/${existingAwayStatId}`
                        : 'https://localhost:7078/api/MatchStatistics', {
                        method: existingAwayStatId ? 'PUT' : 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(existingAwayStatId ? { id: existingAwayStatId, ...awayData } : awayData)
                    }),
                ]);
                els.statsModal.close();
                toast('İstatistikler başarıyla kaydedildi.');
            } catch (err) {
                toast('Kaydedilemedi: ' + err.message, 'info');
            }

        })


        /* ---------- Toast ---------- */
        function toast(message, type = 'success') {
            const el = document.createElement('div');
            el.className = `toast-a toast-a--${type}`;
            el.setAttribute('role', 'status');
            el.innerHTML = `${icon(type === 'success' ? 'check' : 'info')}<span>${esc(message)}</span>`;
            els.toasts.appendChild(el);
            setTimeout(() => el.remove(), 3500);
        }

        /* ---------- Sidebar (mobil) ---------- */
        const toggleBtn = $('[data-sidebar-toggle]');
        function setSidebar(open) {
            document.body.classList.toggle('sidebar-open', open);
            toggleBtn.setAttribute('aria-expanded', String(open));
        }
        toggleBtn.addEventListener('click', () => setSidebar(!document.body.classList.contains('sidebar-open')));
        $('[data-sidebar-close]').addEventListener('click', () => setSidebar(false));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setSidebar(false); });

        /* Demo: diğer sayfalar bu dosyada yok */
        document.addEventListener('click', (e) => {
            const nav = e.target.closest('[data-demo-nav], [data-demo-action]');
            if (!nav) return;
            e.preventDefault();
            toast('Demo modunda yalnızca Maç Yönetimi ekranı açık.', 'info');
        });

        renderTable();
    })();
</script>