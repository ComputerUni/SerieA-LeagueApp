@model MatchListViewModel

<script>
    /* =============================================================
       Serie A Admin - admin.js
       Demo veri + filtre + ekle/düzenle/sil. API'ye geçişte MatchService değişir.
       ============================================================= */
    (function() {
        'use strict';

    let teams = @Html.Raw(Json.Serialize(Model.Teams.Select(t => new
        {
            
        })));

        const TEAMS = {
            atalanta: { name: 'Atalanta', a: '#1E6FB8', b: '#111111', stadium: 'Gewiss Stadium' },
            bologna: { name: 'Bologna', a: '#1A2F5A', b: '#A21C26', stadium: "Stadio Renato Dall'Ara" },
            cagliari: { name: 'Cagliari', a: '#A5162B', b: '#0E2A56', stadium: 'Unipol Domus' },
            como: { name: 'Como', a: '#0B3E91', b: '#FFFFFF', stadium: 'Stadio Giuseppe Sinigaglia' },
            fiorentina: { name: 'Fiorentina', a: '#5B2A86', b: '#FFFFFF', stadium: 'Stadio Artemio Franchi' },
            frosinone: { name: 'Frosinone', a: '#1C4E9A', b: '#FFD200', stadium: 'Stadio Benito Stirpe' },
            genoa: { name: 'Genoa', a: '#A2172E', b: '#002B5C', stadium: 'Stadio Luigi Ferraris' },
            inter: { name: 'Inter', a: '#0A4FA8', b: '#101418', stadium: 'San Siro' },
            juventus: { name: 'Juventus', a: '#16181D', b: '#E8E8E8', stadium: 'Allianz Stadium' },
            lazio: { name: 'Lazio', a: '#8FD3F4', b: '#FFFFFF', stadium: 'Stadio Olimpico' },
            lecce: { name: 'Lecce', a: '#F6D000', b: '#D21F26', stadium: 'Stadio Via del Mare' },
            milan: { name: 'Milan', a: '#C8141E', b: '#111111', stadium: 'San Siro' },
            monza: { name: 'Monza', a: '#D2122E', b: '#FFFFFF', stadium: 'U-Power Stadium' },
            napoli: { name: 'Napoli', a: '#1E9BD7', b: '#0C3C78', stadium: 'Stadio Diego Armando Maradona' },
            parma: { name: 'Parma', a: '#FFD200', b: '#1D3E8A', stadium: 'Stadio Ennio Tardini' },
            roma: { name: 'Roma', a: '#8E1F2F', b: '#F0B323', stadium: 'Stadio Olimpico' },
            sassuolo: { name: 'Sassuolo', a: '#00A651', b: '#111111', stadium: 'Mapei Stadium' },
            torino: { name: 'Torino', a: '#7E1B1B', b: '#E9D9B0', stadium: 'Stadio Olimpico Grande Torino' },
            udinese: { name: 'Udinese', a: '#26282C', b: '#FFFFFF', stadium: 'Bluenergy Stadium' },
            venezia: { name: 'Venezia', a: '#141414', b: '#F06A1A', stadium: 'Stadio Pier Luigi Penzo' }
        };
        const STATUS = { NotStarted: 'Başlamadı', Live: 'Canlı', Finished: 'Tamamlandı', Postponed: 'Ertelendi' };

        /* Demo kayıtlar (API: GET /api/admin/matches) */
        let matches = [
            { id: 95, week: 11, date: '2026-10-31', time: '18:00', home: 'roma', away: 'inter', homeScore: 1, awayScore: 2, status: 'Finished' },
            { id: 96, week: 11, date: '2026-10-31', time: '20:45', home: 'napoli', away: 'atalanta', homeScore: 2, awayScore: 0, status: 'Finished' },
            { id: 97, week: 11, date: '2026-11-01', time: '15:00', home: 'bologna', away: 'milan', homeScore: 1, awayScore: 3, status: 'Finished' },
            { id: 101, week: 12, date: '2026-11-08', time: '20:45', home: 'milan', away: 'roma', homeScore: 2, awayScore: 1, status: 'Finished' },
            { id: 102, week: 12, date: '2026-11-09', time: '18:00', home: 'inter', away: 'napoli', homeScore: null, awayScore: null, status: 'NotStarted' },
            { id: 103, week: 12, date: '2026-11-09', time: '21:45', home: 'juventus', away: 'lazio', homeScore: 1, awayScore: 1, status: 'Live' },
            { id: 104, week: 12, date: '2026-11-08', time: '15:00', home: 'atalanta', away: 'fiorentina', homeScore: 3, awayScore: 0, status: 'Finished' },
            { id: 105, week: 12, date: '2026-11-09', time: '15:00', home: 'torino', away: 'bologna', homeScore: 0, awayScore: 0, status: 'Live' },
            { id: 106, week: 12, date: '2026-11-10', time: '20:45', home: 'lecce', away: 'monza', homeScore: null, awayScore: null, status: 'Postponed' },
            { id: 107, week: 12, date: '2026-11-10', time: '18:30', home: 'como', away: 'parma', homeScore: null, awayScore: null, status: 'NotStarted' },
            { id: 108, week: 13, date: '2026-11-14', time: '20:45', home: 'inter', away: 'juventus', homeScore: null, awayScore: null, status: 'NotStarted' },
            { id: 109, week: 13, date: '2026-11-14', time: '18:00', home: 'napoli', away: 'milan', homeScore: null, awayScore: null, status: 'NotStarted' }
        ].map((m) => ({ ...m, stadium: TEAMS[m.home].stadium }));

        /* ---------- Yardımcılar ---------- */
        const $ = (sel, root = document) => root.querySelector(sel);
        const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        const fmtDate = (iso) => iso.split('-').reverse().join('.');
        const norm = (s) => s.toLocaleLowerCase('tr-TR').normalize('NFD').replace(/[\u0300-\u036f]/g, '');
        const hasScore = (m) => m.status === 'Live' || m.status === 'Finished';
        const icon = (id) => `<svg class="icon" aria-hidden="true"><use href="#i-${id}"/></svg>`;
        const teamCell = (id) =>
            `<span class="team"><span class="team-crest" style="--crest-a:${TEAMS[id].a};--crest-b:${TEAMS[id].b}" aria-hidden="true"></span>${esc(TEAMS[id].name)}</span>`;

        /* ---------- Tablo ---------- */
        const els = {
            rows: $('[data-match-rows]'),
            count: $('[data-result-count]'),
            filter: $('[data-filter-form]'),
            modal: $('#match-modal'),
            form: $('[data-match-form]'),
            title: $('#match-modal-title'),
            alert: $('[data-form-alert]'),
            scoreFields: $('[data-score-fields]'),
            del: $('#delete-modal'),
            delText: $('[data-delete-text]'),
            toasts: $('[data-toasts]')
        };
        let filters = { team: '', week: '', status: '' };

        function applyFilters(list) {
            const q = norm(filters.team.trim());
            return list.filter((m) =>
                (!q || norm(TEAMS[m.home].name).includes(q) || norm(TEAMS[m.away].name).includes(q)) &&
                (!filters.week || String(m.week) === filters.week) &&
                (!filters.status || m.status === filters.status));
        }

        function renderTable(highlightId) {
            const list = applyFilters(matches).sort((a, b) => a.id - b.id);
            if (!list.length) {
                els.rows.innerHTML = `<tr class="table-empty"><td colspan="9"><strong>Kayıt bulunamadı</strong>Filtreleri değiştirin ya da Temizle ile tüm maçları gösterin.</td></tr>`;
            } else {
                els.rows.innerHTML = list.map((m) => `
                            <tr data-id="${m.id}"${m.id === highlightId ? ' class="is-new"' : ''}>
                              <td class="col-id"><span>${m.id}</span></td>
                              <td class="week-cell">${m.week}. Hafta</td>
                              <td>${fmtDate(m.date)}</td>
                              <td>${m.time}</td>
                              <td>${teamCell(m.home)}</td>
                              <td class="col-score">${hasScore(m)
                        ? `<span class="score">${m.homeScore} - ${m.awayScore}</span>`
                        : '<span class="score score--empty">-</span>'}</td>
                              <td>${teamCell(m.away)}</td>
                              <td><span class="badge-a badge-a--${m.status}">${STATUS[m.status]}</span></td>
                              <td class="col-actions">
                                <div class="row-actions">
                                  <a class="act-btn" href="/Admin/Matches/Detail/${m.id}" data-demo-nav title="Detay" aria-label="Detay: ${esc(TEAMS[m.home].name)} - ${esc(TEAMS[m.away].name)}">${icon('eye')}</a>
                                  <button type="button" class="act-btn" data-edit="${m.id}" title="Düzenle" aria-label="Düzenle: ${esc(TEAMS[m.home].name)} - ${esc(TEAMS[m.away].name)}">${icon('edit')}</button>
                                  <button type="button" class="act-btn act-btn--danger" data-delete="${m.id}" title="Sil" aria-label="Sil: ${esc(TEAMS[m.home].name)} - ${esc(TEAMS[m.away].name)}">${icon('trash')}</button>
                                </div>
                              </td>
                            </tr>`).join('');
            }
            els.count.textContent = `${matches.length} kayıttan ${list.length} tanesi gösteriliyor`;
        }

        els.filter.addEventListener('submit', (e) => {
            e.preventDefault();
            const fd = new FormData(els.filter);
            filters = { team: fd.get('team') || '', week: fd.get('week') || '', status: fd.get('status') || '' };
            renderTable();
        });
        $('[data-filter-reset]').addEventListener('click', () => {
            els.filter.reset();
            filters = { team: '', week: '', status: '' };
            renderTable();
        });

        /* ---------- Form seçeneklerini doldur ---------- */
        const f = els.form.elements;
        f.week.innerHTML = '<option value="">Hafta seçin</option>' +
            Array.from({ length: 38 }, (_, i) => `<option value="${i + 1}">${i + 1}. Hafta</option>`).join('');
        const teamOptions = '<option value="">Takım seçin</option>' +
            Object.entries(TEAMS).map(([id, t]) => `<option value="${id}">${t.name}</option>`).join('');
        f.home.innerHTML = teamOptions;
        f.away.innerHTML = teamOptions;

        let stadiumTouched = false;
        f.stadium.addEventListener('input', () => { stadiumTouched = f.stadium.value.trim() !== ''; });
        f.home.addEventListener('change', () => {
            if (!stadiumTouched && TEAMS[f.home.value]) f.stadium.value = TEAMS[f.home.value].stadium;
            clearError('home');
        });
        f.status.addEventListener('change', toggleScoreFields);
        function toggleScoreFields() {
            const show = f.status.value === 'Live' || f.status.value === 'Finished';
            els.scoreFields.hidden = !show;
            if (!show) { clearError('homeScore'); clearError('awayScore'); }
        }
        ['week', 'away', 'date', 'time', 'homeScore', 'awayScore'].forEach((n) =>
            f[n].addEventListener('input', () => clearError(n)));

        /* ---------- Doğrulama ---------- */
        function setError(name, msg) {
            const field = els.form.querySelector(`[data-field="${name}"]`);
            field.classList.add('has-error');
            field.querySelector('.field-error').textContent = msg;
            f[name].setAttribute('aria-invalid', 'true');
        }
        function clearError(name) {
            const field = els.form.querySelector(`[data-field="${name}"]`);
            if (!field) return;
            field.classList.remove('has-error');
            f[name].removeAttribute('aria-invalid');
        }
        function clearAllErrors() {
            els.form.querySelectorAll('.has-error').forEach((el) => el.classList.remove('has-error'));
            els.form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
            els.alert.classList.remove('is-visible');
        }

        function validate(data) {
            const errors = [];
            if (!data.week) errors.push(['week', 'Lütfen bir hafta seçin.']);
            if (!data.home) errors.push(['home', 'Lütfen ev sahibi takımı seçin.']);
            if (!data.away) errors.push(['away', 'Lütfen deplasman takımını seçin.']);
            else if (data.home && data.home === data.away) errors.push(['away', 'Ev sahibi ve deplasman takımı aynı olamaz.']);
            if (!data.date) errors.push(['date', 'Lütfen maç tarihini seçin.']);
            if (!data.time) errors.push(['time', 'Lütfen maç saatini seçin.']);
            if (data.status === 'Live' || data.status === 'Finished') {
                ['homeScore', 'awayScore'].forEach((k) => {
                    const v = data[k];
                    if (v === '' || !Number.isInteger(Number(v)) || Number(v) < 0)
                        errors.push([k, 'Geçerli bir skor girin (0 veya üzeri).']);
                });
            }
            return errors;
        }

        /* ---------- Modal aç / kapat ---------- */
        let lastFocus = null;
        function openModal(mode, match) {
            lastFocus = document.activeElement;
            els.form.reset();
            clearAllErrors();
            stadiumTouched = false;
            f.id.value = '';
            f.status.value = 'NotStarted';
            if (mode === 'edit' && match) {
                els.title.textContent = 'Maçı Düzenle';
                f.id.value = match.id;
                f.week.value = match.week;
                f.home.value = match.home;
                f.away.value = match.away;
                f.date.value = match.date;
                f.time.value = match.time;
                f.stadium.value = match.stadium || '';
                f.status.value = match.status;
                f.homeScore.value = match.homeScore ?? '';
                f.awayScore.value = match.awayScore ?? '';
                stadiumTouched = true;
            } else {
                els.title.textContent = 'Yeni Maç Ekle';
            }
            toggleScoreFields();
            els.modal.showModal();
            f.week.focus();
        }
        function closeModal() {
            els.modal.close();
        }
        els.modal.addEventListener('close', () => { if (lastFocus) lastFocus.focus(); });
        els.modal.addEventListener('click', (e) => { if (e.target === els.modal) closeModal(); });  // arka plana tıklama
        document.querySelectorAll('[data-modal-close]').forEach((b) => b.addEventListener('click', closeModal));
        $('[data-open-create]').addEventListener('click', () => openModal('create'));

        /* ---------- Kaydet (ekle / güncelle) ---------- */
        els.form.addEventListener('submit', (e) => {
            e.preventDefault();
            clearAllErrors();
            const data = Object.fromEntries(new FormData(els.form).entries());
            const errors = validate(data);
            if (errors.length) {
                errors.forEach(([name, msg]) => setError(name, msg));
                els.alert.classList.add('is-visible');
                f[errors[0][0]].focus();
                return;
            }

            const scored = data.status === 'Live' || data.status === 'Finished';
            const record = {
                week: Number(data.week),
                date: data.date,
                time: data.time,
                home: data.home,
                away: data.away,
                stadium: data.stadium.trim() || TEAMS[data.home].stadium,
                status: data.status,
                homeScore: scored ? Number(data.homeScore) : null,
                awayScore: scored ? Number(data.awayScore) : null
            };

            let savedId;
            if (data.id) {
                // API: PUT /api/admin/matches/{id}
                savedId = Number(data.id);
                matches = matches.map((m) => (m.id === savedId ? { ...m, ...record } : m));
                toast('Maç başarıyla güncellendi.');
            } else {
                // API: POST /api/admin/matches
                savedId = Math.max(0, ...matches.map((m) => m.id)) + 1;
                matches.push({ id: savedId, ...record });
                toast('Maç başarıyla eklendi.');
            }
            closeModal();
            renderTable(savedId);
            const row = els.rows.querySelector(`[data-id="${savedId}"]`);
            if (row) row.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
            else toast('Yeni kayıt mevcut filtreler nedeniyle gizli.', 'info');
        });

        /* ---------- Düzenle / Sil ---------- */
        let pendingDelete = null;
        els.rows.addEventListener('click', (e) => {
            const edit = e.target.closest('[data-edit]');
            const del = e.target.closest('[data-delete]');
            if (edit) openModal('edit', matches.find((m) => m.id === Number(edit.dataset.edit)));
            if (del) {
                const m = matches.find((x) => x.id === Number(del.dataset.delete));
                pendingDelete = m.id;
                els.delText.innerHTML = `<strong>${esc(TEAMS[m.home].name)} - ${esc(TEAMS[m.away].name)}</strong> (ID ${m.id}, ${m.week}. Hafta) kalıcı olarak silinecek. Bu işlem geri alınamaz.`;
                els.del.returnValue = '';
                els.del.showModal();
            }
        });
        els.del.addEventListener('close', () => {
            if (els.del.returnValue === 'confirm' && pendingDelete !== null) {
                // API: DELETE /api/admin/matches/{id}
                matches = matches.filter((m) => m.id !== pendingDelete);
                renderTable();
                toast('Maç silindi.');
            }
            pendingDelete = null;
        });

        /* ---------- Toast ---------- */
        function toast(message, type = 'success') {
            const el = document.createElement('div');
            el.className = `toast-a toast-a--${type}`;
            el.setAttribute('role', 'status');
            el.innerHTML = `${icon(type === 'success' ? 'check' : 'info')}<span>${esc(message)}</span>`;
            els.toasts.appendChild(el);
            setTimeout(() => el.remove(), 3500);
        }

        /* ---------- Sidebar (mobil) ---------- */
        const toggleBtn = $('[data-sidebar-toggle]');
        function setSidebar(open) {
            document.body.classList.toggle('sidebar-open', open);
            toggleBtn.setAttribute('aria-expanded', String(open));
        }
        toggleBtn.addEventListener('click', () => setSidebar(!document.body.classList.contains('sidebar-open')));
        $('[data-sidebar-close]').addEventListener('click', () => setSidebar(false));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setSidebar(false); });

        /* Demo: diğer sayfalar bu dosyada yok */
        document.addEventListener('click', (e) => {
            const nav = e.target.closest('[data-demo-nav], [data-demo-action]');
            if (!nav) return;
            e.preventDefault();
            toast('Demo modunda yalnızca Maç Yönetimi ekranı açık.', 'info');
        });

        renderTable();
    })();
</script>