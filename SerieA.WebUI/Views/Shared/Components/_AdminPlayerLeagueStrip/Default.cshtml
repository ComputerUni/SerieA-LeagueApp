@model int

<div class="player-strip">
    <div class="strip-item strip-item--blue">
        <div class="strip-icon">
            <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
        </div>
        <div>
            <span class="strip-label">Kayıtlı Oyuncu</span>
            <span class="strip-value">@Model <small>futbolcu</small></span>
        </div>
    </div>
    <div class="strip-item strip-item--green">
        <div class="strip-icon">
            <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1" />
            </svg>
        </div>
        <div>
            <span class="strip-label">Aktif Kulüpler</span>
            <span class="strip-value">@(ViewBag.TeamCount ?? 0) <small>kulüp</small></span>
        </div>
    </div>
    <div class="strip-item strip-item--navy">
        <div class="strip-icon">
            <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064" />
            </svg>
        </div>
        <div>
            <span class="strip-label">Lig Formatı</span>
            <span class="strip-value">Serie A <small>TIM</small></span>
        </div>
    </div>
    <div class="strip-item strip-item--red">
        <div class="strip-icon">
            <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
        </div>
        <div>
            <span class="strip-label">Lisans Durumu</span>
            <span class="strip-value">FIGC <small>Onaylı</small></span>
        </div>
    </div>
</div>