@using SerieA.API.DTOs.PlayerDtos
@using SerieA.API.DTOs.TeamDtos
@using SerieA.API.Extensions
@model List<ResultPlayerDto>

@{
    var teams = ViewBag.Teams as List<ResultTeamDto>;
    var positions = ViewBag.Positions as List<SelectListItem>;
}

<div class="card-a">
    <div class="filter-bar">
        <div class="filter-search form-field">
            <label class="field-label" for="searchPlayer">Oyuncu Ara</label>
            <div class="input-icon">
                <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <input type="text" id="searchPlayer" class="input-a" placeholder="Ad, soyad veya uyruk arayın..." oninput="filterPlayers()">
            </div>
        </div>
        <div class="form-field">
            <label class="field-label" for="filterTeam">Takıma Göre</label>
            <select id="filterTeam" class="select-a" onchange="filterPlayers()">
                <option value="">Tüm Takımlar</option>
                @if (teams != null)
                {
                    foreach (var t in teams)
                    {
                        <option value="@t.Name">@t.Name</option>
                    }
                }
            </select>
        </div>
        <div class="form-field">
            <label class="field-label" for="filterPos">Mevkiye Göre</label>
            <select id="filterPos" class="select-a" onchange="filterPlayers()">
                <option value="">Tüm Mevkiler</option>
                @if (positions != null)
                {
                    foreach (var pos in positions)
                    {
                        <option value="@pos.Value">@pos.Text</option>
                    }
                }
            </select>
        </div>
        <div class="filter-actions">
            <button type="button" class="btn-a btn-a--secondary" onclick="resetPlayerFilters()">Temizle</button>
        </div>
    </div>

    <div class="table-scroll">
        <table class="team-table" id="playerTable">
            <thead>
                <tr>
                    <th class="col-id text-center">No</th>
                    <th>Oyuncu</th>
                    <th>Kulüp</th>
                    <th>Mevki</th>
                    <th>Doğum Tarihi</th>
                    <th>Uyruk</th>
                    <th class="col-actions">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        var teamName = teams?.FirstOrDefault(t => t.Id == item.TeamId)?.Name ?? "Takımsız";
                        <tr>
                            <td class="text-center">
                                <span class="shirt-pill">@(item.ShirtNumber > 0 ? item.ShirtNumber : "-")</span>
                            </td>
                            <td>
                                <div class="team-cell">
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://placehold.co/80x80/081530/FFFFFF?text=P" : item.ImageUrl)"
                                         alt="@item.FirstName @item.LastName"
                                         class="player-avatar-cell"
                                         referrerpolicy="no-referrer"
                                         loading="lazy"
                                         onerror="this.onerror=null; this.src='https://placehold.co/80x80/081530/FFFFFF?text=P';" />
                                    <div>
                                        <span class="team-name">@item.FirstName @item.LastName</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge-a badge-a--active">@teamName</span>
                            </td>
                            <td>
                                <span class="badge-pos">@item.Position.GetDisplayName()</span>
                            </td>
                            <td class="text-muted" style="font-size: .85rem;">
                                @item.BirthDate.ToString("dd.MM.yyyy")
                            </td>
                            <td>
                                <span class="region region--center">@item.Nationality</span>
                            </td>
                            <td class="col-actions">
                                <div class="row-actions">
                                    <a href="/Player/UpdatePlayer/@item.Id" class="act-btn" title="Düzenle">
                                        <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                        </svg>
                                    </a>
                                    <a href="/Player/DeletePlayer/@item.Id" class="act-btn act-btn--danger" onclick="return confirm('@item.FirstName @item.LastName isimli futbolcuyu silmek istediğinize emin misiniz?')" title="Sil">
                                        <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                        </svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr class="table-empty">
                        <td colspan="7">
                            <strong>Kayıtlı Oyuncu Bulunamadı</strong>
                            Veritabanında henüz listelenecek bir futbolcu verisi bulunmuyor.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="table-foot">
        <span>Toplam @(Model?.Count ?? 0) aktif futbolcu listeleniyor</span>
        <span class="text-dim">Serie A Official Data Provider</span>
    </div>
</div>