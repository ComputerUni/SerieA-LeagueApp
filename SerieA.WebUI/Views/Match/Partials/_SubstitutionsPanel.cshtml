@using SerieA.API.DTOs.MatchDtos
@model MatchStatisticsViewModel

@{
    var substitutions = Model.Match.Substitutions.OrderBy(s => s.Minute).ToList();
    var homeSubs = substitutions.Where(s => s.TeamId == Model.Match.HomeTeamId).ToList();
    var awaySubs = substitutions.Where(s => s.TeamId == Model.Match.AwayTeamId).ToList();
}

<section class="panel" aria-labelledby="subs-title">
    <div class="panel__head"><h2 class="panel__title" id="subs-title">Oyuncu değişiklikleri</h2></div>
    <div class="split">
        @foreach (var (teamSubs, teamName, teamLogo) in new[]
        {
        (homeSubs, Model.Match.HomeTeamName, Model.Match.HomeTeamLogo),
        (awaySubs, Model.Match.AwayTeamName, Model.Match.AwayTeamLogo)
    })
        {
            <div class="split__col">
                <h3 class="split__team">

                    <img style="width:25px;height:25px;" src="@teamLogo" alt="@teamName" />

                    @teamName
                    <span class="split__count">@teamSubs.Count değişiklik</span>
                </h3>
                <ul class="item-list">
                    @foreach (var s in teamSubs)
                    {
                        <li>
                            <span class="item-minute">@s.Minute'</span>
                            <span class="item-main">
                                <strong class="sub-in">@s.PlayerInName</strong>
                                <small class="sub-out">@s.PlayerOutName</small>
                            </span>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</section>