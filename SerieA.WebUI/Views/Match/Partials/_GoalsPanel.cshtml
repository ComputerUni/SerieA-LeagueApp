@using SerieA.API.DTOs.MatchDtos
@model MatchStatisticsViewModel

@{
    var goals = Model.Match.Goals.OrderBy(g => g.Minute).ToList();
    var homeGoals = goals.Where(g => g.TeamId == Model.Match.HomeTeamId).ToList();
    var awayGoals = goals.Where(g => g.TeamId == Model.Match.AwayTeamId).ToList();
}

<section class="panel" aria-labelledby="goals-title">
    <div class="panel__head"><h2 class="panel__title" id="goals-title">Goller</h2></div>
    <div class="split">
        @foreach (var (teamGoals, teamName, teamLogo) in new[]
        {
            (homeGoals, Model.Match.HomeTeamName, Model.Match.HomeTeamLogo),
            (awayGoals, Model.Match.AwayTeamName, Model.Match.AwayTeamLogo)
        })
        {
            <div class="split__col">
                <h3 class="split__team">

                    <img src="@teamLogo"
                         style="width:25px;height:25px;"
                         alt="@teamName"
                         onerror="this.style.display='none'" />

                    @teamName
                    <span class="split__count">@teamGoals.Count gol</span>
                </h3>
                <ul class="item-list goal-list">
                    @foreach (var g in teamGoals)
                    {
                        <li>
                            <span class="item-minute">@g.Minute'</span>
                            <span class="item-main"><strong>@g.PlayerName</strong></span>
                        </li>
                    }
                </ul>
            </div>
        }

    </div>
</section>
