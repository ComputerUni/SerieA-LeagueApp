@using SerieA.API.Entities.Enums
@using SerieA.API.Extensions
@model MatchStatisticsViewModel

@{
    var htHome = Model.Match.Goals.Count(g => g.TeamId == Model.Match.HomeTeamId && g.Minute <= 45);
    var htAway = Model.Match.Goals.Count(g => g.TeamId == Model.Match.AwayTeamId && g.Minute <= 45);

    var homeScore = 0;
    var awayScore = 0;
    var halfTimeRendered = false;

    var cards = Model.Match.Cards.Select(c => new { c.Minute, Type = c.CardType == CardType.YellowCard ? "yellow" : "red", c.TeamId, PlayerName = c.PlayerName, Sub = (string?)null });
    var goals = Model.Match.Goals.Select(g => new { g.Minute, Type = "goal", g.TeamId, g.PlayerName, Sub = (string?)null });
    var subs = Model.Match.Substitutions.Select(s => new { s.Minute, Type = "sub", s.TeamId, PlayerName = s.PlayerInName, Sub = s.PlayerOutName });

    var allEvents = goals.Cast<dynamic>().Concat(cards.Cast<dynamic>()).Concat(subs.Cast<dynamic>()).OrderBy(e => e.Minute).ToList();
}


<header class="match-hero">
    <div class="hero-topbar">
        <ul class="comp-tags" aria-label="Müsabaka">
            <li class="comp-tag comp-tag--league">Serie A</li>
            <li class="comp-tag">2026/27</li>
            <li class="comp-tag">@Model.Match.Week. Hafta</li>
        </ul>
        <span class="status-pill">@Model.Match.Status.GetDisplayName()</span>
    </div>

    <div class="scoreboard">
        <div class="sb-team sb-team--home">

            <img src="@Model.Match.HomeTeamLogo" alt="@Model.Match.HomeTeamName" />

            <div>
                <span class="sb-team__role">Ev sahibi</span>
                <h1 class="sb-team__name">@Model.Match.HomeTeamName</h1>
                <ul class="sb-scorers" aria-label="@Model.Match.HomeTeamName golleri">
                    @foreach (var goal in Model.Match.Goals.Where(g => g.TeamId == Model.Match.HomeTeamId))
                    {
                        <li>
                            <svg class="i-ball" aria-hidden="true"><use href="#i-ball" /></svg>
                            @goal.PlayerName @goal.Minute'
                        </li>
                    }
                </ul>
            </div>
        </div>

        <div class="sb-score">
            <p class="sb-score__value" aria-label="Skor: @Model.Match.HomeTeamName @Model.Match.HomeTeamScore, @Model.Match.AwayTeamName @Model.Match.AwayTeamScore">
                <span>@Model.Match.HomeTeamScore</span><span class="sb-score__sep" aria-hidden="true"></span><span class="is-loser">@Model.Match.AwayTeamScore</span>
            </p>
            <p class="sb-score__ht">İlk yarı @htHome-@htAway</p>
        </div>

        <div class="sb-team sb-team--away is-loser">
            <img src="@Model.Match.AwayTeamLogo" alt="@Model.Match.AwayTeamName" />
            <div>
                <span class="sb-team__role">Deplasman</span>
                <h2 class="sb-team__name">@Model.Match.AwayTeamName</h2>
                <ul class="sb-scorers" aria-label="@Model.Match.AwayTeamName golleri">
                    @foreach (var goal in Model.Match.Goals.Where(g => g.TeamId == Model.Match.AwayTeamId))
                    {
                        <li>
                            <svg class="i-ball" aria-hidden="true"><use href="#i-ball" /></svg>
                            @goal.PlayerName @goal.Minute'
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <ul class="hero-facts">
        <li><svg aria-hidden="true"><use href="#i-calendar" /></svg>@Model.Match.MatchDate.ToString("dd MMMM yyyy")</li>
        <li><svg aria-hidden="true"><use href="#i-clock" /></svg>@Model.Match.MatchTime.ToString("HH:mm")</li>
        <li><svg aria-hidden="true"><use href="#i-stadium" /></svg>@Model.Match.Stadium</li>
        <li><svg aria-hidden="true"><use href="#i-whistle" /></svg><span>Hakem:</span> Daniele Orsato</li>
    </ul>

    <!-- Partial: _MatchFlowStrip -->
    <section class="flow-strip" aria-labelledby="flow-title">
        <div class="flow-head">
            <h2 class="flow-title" id="flow-title">Maç akışı</h2>
            <p class="flow-hint">Ayrıntısını görmek için bir olaya dokun</p>
        </div>
        <div class="flow-scroll">
            <div class="flow-track">
                <span class="flow-side-label flow-side-label--home"><img style="width:25px; height:25px;" src="@Model.Match.HomeTeamLogo" alt="@Model.Match.HomeTeamName" /></span>
                <span class="flow-side-label flow-side-label--away"><img style="width:25px; height:25px;" src="@Model.Match.AwayTeamLogo" alt="@Model.Match.AwayTeamName" /></span>
                <span class="flow-axis" aria-hidden="true"></span>
                <span class="flow-half" aria-hidden="true"><span>Devre arası</span></span>
                <span class="flow-tick" style="--x:calc(15 / 95 * 100%)">15'</span>
                <span class="flow-tick" style="--x:calc(30 / 95 * 100%)">30'</span>
                <span class="flow-tick" style="--x:calc(45 / 95 * 100%)">45'</span>
                <span class="flow-tick" style="--x:calc(60 / 95 * 100%)">60'</span>
                <span class="flow-tick" style="--x:calc(75 / 95 * 100%)">75'</span>
                <span class="flow-tick" style="--x:calc(90 / 95 * 100%)">90'</span>

                @foreach (var e in allEvents)
                {
                    var isHome = e.TeamId == Model.Match.HomeTeamId;
                    var sideClass = isHome ? "flow-marker--home" : "flow-marker--away";
                    var typeClass = e.Type == "goal" ? "flow-marker--goal" :
                                    e.Type == "sub" ? "flow-marker--sub" : "flow-marker--card";
                    <button type="button"
                            class="flow-marker @sideClass @typeClass"
                            style="--m:@e.Minute"
                            data-flow-ref="ev-@(e.Type)-@(e.Minute)"
                            title="@e.Minute' @(e.Type == "goal" ? "Gol" : e.Type == "sub" ? "Değişiklik" : "Kart"): @e.PlayerName"
                            aria-label="@e.Minute. dakika, @e.PlayerName">
                        <span class="flow-marker__dot">
                            @if (e.Type == "goal")
                            {
                                <svg class="i-ball" aria-hidden="true"><use href="#i-ball" /></svg>
                            }
                            else if (e.Type != "sub")
                            {
                                <span class="i-card @(e.Type == "yellow" ? "i-card--yellow" : "i-card--red")"></span>
                            }
                        </span>
                    </button>
                }

                

            </div>
        </div>
    </section>
</header>
