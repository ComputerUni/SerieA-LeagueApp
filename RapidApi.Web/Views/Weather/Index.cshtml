@model WeatherViewModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container my-4" style="max-width: 580px;">

    <!-- 1. Arama Formu Kartı -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <div class="d-flex align-items-center mb-3">
                <span class="badge bg-primary me-2 p-2">
                    <i class="bi bi-cloud-sun fs-6"></i>
                </span>
                <div>
                    <h5 class="card-title mb-0 fw-bold">Canlı Hava Durumu</h5>
                    <small class="text-muted">OpenWeatherMap Servisi</small>
                </div>
            </div>

            <form method="post">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="bi bi-geo-alt text-muted"></i>
                    </span>
                    <input type="text" 
                           name="cityName" 
                           class="form-control bg-light border-start-0 ps-0" 
                           placeholder="Şehir adı yazınız (örn: Gaziantep)..." 
                           required />
                    <button class="btn btn-primary px-4 fw-semibold" type="submit">
                        <i class="bi bi-search me-1"></i> Sorgula
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (Model != null)
    {
        <div class="card shadow-sm border-0 border-top border-primary border-3">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center pb-3 border-bottom mb-3">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-building me-1 text-primary"></i> @Model.name
                    </h5>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                        Güncel Bilgi
                    </span>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="display-5 fw-bold text-dark mb-0">
                            @Model.main.tempInCelsius°C
                        </div>
                        <div class="text-muted text-capitalize mt-1">
                            @Model.weather[0].description
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (ViewBag.Searched == true)
    {
        <div class="alert alert-danger d-flex align-items-center shadow-sm border-0" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 me-2 shrink-0"></i>
            <div>
                Aradığınız şehrin hava durumu bilgisi bulunamadı. Lütfen ismi kontrol edip tekrar deneyiniz.
            </div>
        </div>
    }

</div>