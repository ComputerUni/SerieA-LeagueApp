@model List<ImdbMoviesViewModel>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h3 class="text-decoration-underline">IMDb En İyi 100 Film Listesi</h3>

<table class="table table-hover table-bordered table-striped">
    <thead class="table table-responsive-xl">
        <tr>
            <th>#</th>
            <th>Afiş</th>
            <th>Film Adı</th>
            <th>Çıkış Yılı</th>
            <th>Konusu</th>
            <th>Imdb Link</th>
            <th>Puan</th>
        </tr>
    </thead>
    <tbody class="table table-striped table-responsive-xl">
        @foreach (var item in Model)
        {
            <tr>
                <th>@item.rank</th>
                <td><img src="@item.thumbnail" /></td>
                <td>@item.title</td>
                <td>@item.year</td>
                <td>@item.description</td>
                <td><a href="@item.imdb_link" target="_blank" class="btn btn-outline-secondary">Imdb Linki</a></td>
                <td class="fw-bold">@item.rating</td>
            </tr>
        }
    </tbody>
</table>


